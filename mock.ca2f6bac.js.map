$f39c45f83a337f54$exports = JSON.parse('[{"category":"ONGOING","name":"Project Aura","isApplicationOpen":true,"duration":"2026 Summer ~ 2027 Spring","client":"Harvard Arts Festival","description":"Project AURA\uB294 \uD559\uC0DD\uB4E4\uC758 \uCC3D\uC758\uC131\uACFC \uAC10\uC815\uC744 \uC911\uC2EC\uC73C\uB85C, AI\uB97C \uCC3D\uC791\uC758 \uD611\uC5C5 \uB3C4\uAD6C\uB85C \uD65C\uC6A9\uD558\uB294 Human-Centered Creative AI \uD504\uB85C\uC81D\uD2B8\uC785\uB2C8\uB2E4. \uD559\uC0DD\uB4E4\uC740 \uC74C\uC545, \uAE00\uC4F0\uAE30, \uC2DC\uAC01 \uC608\uC220, \uC778\uD130\uB799\uD2F0\uBE0C \uBBF8\uB514\uC5B4 \uB4F1 \uB2E4\uC591\uD55C \uBD84\uC57C\uC5D0\uC11C \uC790\uC2E0\uC758 \uC544\uC774\uB514\uC5B4\uC640 \uD45C\uD604\uC744 \uAE30\uBC18\uC73C\uB85C AI\uC640 \uD568\uAED8 \uC0C8\uB85C\uC6B4 \uC608\uC220 \uCF58\uD150\uCE20\uC640 \uD50C\uB7AB\uD3FC\uC744 \uC81C\uC791\uD558\uAC8C \uB429\uB2C8\uB2E4. Project AURA\uB294 \uB2E8\uC21C\uD788 AI\uAC00 \uACB0\uACFC\uBB3C\uC744 \uC0DD\uC131\uD558\uB294 \uAC83\uC774 \uC544\uB2C8\uB77C, \uC778\uAC04\uC758 \uCC3D\uC791 \uACFC\uC815\uC744 \uC911\uC2EC\uC73C\uB85C AI\uAC00 \uC774\uB97C \uD655\uC7A5\uD558\uACE0 \uBCF4\uC644\uD558\uB294 collaborative creative process\uB97C \uD0D0\uAD6C\uD558\uB294 \uAC83\uC744 \uBAA9\uD45C\uB85C \uD569\uB2C8\uB2E4. \uC644\uC131\uB41C \uACB0\uACFC\uBB3C\uACFC \uD50C\uB7AB\uD3FC\uC740 Harvard Arts Festival\uC5D0\uC11C \uC804\uC2DC \uBC0F \uD37C\uD3EC\uBA3C\uC2A4 \uD615\uD0DC\uB85C \uACF5\uAC1C\uB420 \uC608\uC815\uC785\uB2C8\uB2E4.","image":"aura.png","objectPosition":"left","deliverables":null,"link":"/capstone/aura"},{"category":"ONGOING","name":"BridgeMUN","isApplicationOpen":true,"duration":"2026 Summer","client":"Apas Camp Lapu-Lapu Middle School","description":"BridgeMUN\uC740 MUN(Model United Nations) \uCC38\uC5EC \uAE30\uD68C\uAC00 \uC81C\uD55C\uB41C \uD559\uC0DD\uB4E4\uB3C4 AI\uC640 \uD568\uAED8 \uAE00\uB85C\uBC8C \uD1A0\uB860\uACFC \uAD6D\uC81C \uC774\uC288\uB97C \uACBD\uD5D8\uD560 \uC218 \uC788\uB3C4\uB85D \uC124\uACC4\uB41C \uAD50\uC721 \uD50C\uB7AB\uD3FC\uC785\uB2C8\uB2E4. \uD559\uC0DD\uB4E4\uC740 AI Delegate\uC640 \uD1A0\uB860\uD558\uBA70 \uAD6D\uAC00\uBCC4 \uC785\uC7A5\uACFC \uC758\uC81C\uB97C \uBD84\uC11D\uD558\uACE0, \uC2E4\uC81C MUN \uBC29\uC2DD\uC758 \uD68C\uC758\uB97C \uC9C1\uC811 \uACBD\uD5D8\uD558\uAC8C \uB429\uB2C8\uB2E4. \uB610\uD55C AI Coaching \uAE30\uB2A5\uC744 \uD1B5\uD574 \uBC1C\uC5B8 \uAD6C\uC131, \uB17C\uB9AC \uC804\uAC1C, \uD1A0\uB860 \uD0DC\uB3C4\uC5D0 \uB300\uD55C \uD53C\uB4DC\uBC31\uC744 \uBC1B\uC73C\uBA70 \uBE44\uD310\uC801 \uC0AC\uACE0\uB825\uACFC \uAE00\uB85C\uBC8C \uCEE4\uBBA4\uB2C8\uCF00\uC774\uC158 \uC5ED\uB7C9\uC744 \uD0A4\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4. BridgeMUN\uC740 \uC9C0\uC5ED\uACFC \uAD50\uC721 \uD658\uACBD\uC758 \uD55C\uACC4\uB97C \uB118\uC5B4, \uB354 \uB9CE\uC740 \uD559\uC0DD\uB4E4\uC774 \uAE00\uB85C\uBC8C \uD559\uC2B5 \uACBD\uD5D8\uC5D0 \uCC38\uC5EC\uD560 \uC218 \uC788\uB294 \uAE30\uD68C\uB97C \uB9CC\uB4DC\uB294 \uAC83\uC744 \uBAA9\uD45C\uB85C \uD569\uB2C8\uB2E4.","image":"mun.png","objectPosition":"left","deliverables":null,"link":"/capstone/bridgemun"},{"category":"ARCHIVED","name":"Project ResQ","isApplicationOpen":false,"duration":"2026 Summer","client":"Mandaue City Fire Station","description":"Project ResQ\uB294 \uC790\uC5F0\uC7AC\uD574 \uBC1C\uC0DD \uBE48\uB3C4\uAC00 \uB192\uC740 \uC9C0\uC5ED\uC758 \uD654\uC7AC\xb7\uD64D\uC218\xb7\uBD95\uAD34 \uD604\uC7A5\uC5D0 \uBCF4\uB2E4 \uC2E0\uC18D\uD558\uACE0 \uC548\uC804\uD558\uAC8C \uB300\uC751\uD558\uAE30 \uC704\uD574 \uAC1C\uBC1C\uB418\uB294 AI \uAE30\uBC18 \uC7AC\uB09C \uAD6C\uC870 \uD504\uB85C\uC81D\uD2B8\uC785\uB2C8\uB2E4. \uB4DC\uB860\uACFC \uC9C0\uC0C1 \uAD6C\uC870 \uB85C\uBC84\uB97C \uD65C\uC6A9\uD558\uC5EC \uAD6C\uC870\uB300\uAC00 \uC811\uADFC\uD558\uAE30 \uC5B4\uB824\uC6B4 \uC704\uD5D8 \uC9C0\uC5ED\uC758 \uC601\uC0C1\xb7\uC704\uCE58\xb7\uD0D0\uC9C0 \uB370\uC774\uD130\uB97C \uC218\uC9D1\uD558\uACE0, \uC774\uB97C \uAD6C\uC870 \uAE30\uAD00\uC774 \uC2E4\uC2DC\uAC04\uC73C\uB85C \uD655\uC778\uD560 \uC218 \uC788\uB294 \uAD00\uC81C \uC2DC\uC2A4\uD15C\uACFC \uC5F0\uB3D9\uD569\uB2C8\uB2E4. \uB610\uD55C \uD658\uC790\uC758 \uC0C1\uD0DC \uD655\uC778, \uC704\uCE58 \uC804\uB2EC, \uCD08\uAE30 \uC751\uAE09 \uC0C1\uD669 \uD310\uB2E8\uC744 \uC9C0\uC6D0\uD558\uB294 \uAE30\uC220\uC744 \uAC1C\uBC1C\uD558\uC5EC \uC7AC\uB09C \uB300\uC751 \uD6A8\uC728\uC131\uACFC \uC0DD\uC874\uC728 \uD5A5\uC0C1\uC5D0 \uAE30\uC5EC\uD558\uB294 \uAC83\uC744 \uBAA9\uD45C\uB85C \uD569\uB2C8\uB2E4.","image":"resq.png","objectPosition":"left","deliverables":null,"link":"/capstone/resq"},{"category":"ARCHIVED","name":"UNISON Program","isApplicationOpen":false,"duration":"2025 Winter ~ 2026 Spring","client":"SDGIH (SDG Innovation Hub)","description":"UNISON Program\uC740 \uC9C0\uC18D\uAC00\uB2A5\uD55C\uBC1C\uC804(SDG)\uD559\uC2B5\uC5D0 \uAE30\uBC18\uD55C \uAD6D\uC81C \uD559\uC5C5 \uC778\uC99D \uD50C\uB7AB\uD3FC\uC744 \uAC1C\uBC1C\uD569\uB2C8\uB2E4. AI \uD2B8\uB808\uC774\uB2DD\uC744 \uD1B5\uD574 \uAC1C\uBC1C\uB41C \uD559\uC2B5 \uD50C\uB7AB\uD3FC\uC740 \uC804 \uC138\uACC4 \uD559\uC0DD\uB4E4\uC744 \uB300\uC0C1\uC73C\uB85C \uD55C SDG \uAD6D\uC81C \uD559\uC5C5 \uC778\uC99D \uCCB4\uACC4\uC5D0 \uD65C\uC6A9\uB418\uBA70, UN\uC758 SDGIH\uC5D0 \uB3C4\uC785\uB418\uC5B4 \uD65C\uC6A9\uB420 \uC608\uC815\uC785\uB2C8\uB2E4. \uD574\uB2F9 \uD504\uB85C\uADF8\uB7A8\uC740 Columbia University\uC758 Mark Santolucito \uAD50\uC218 (Computer Science \xb7 \uAD50\uC721 \uAE30\uC220 \uBD84\uC57C \uC804\uBB38\uAC00)\uAC00 \uCC38\uC5EC\uD558\uC5EC, AI \uBAA8\uB378 \uC124\uACC4 \uBC0F \uAD50\uC721 \uD50C\uB7AB\uD3FC \uAD6C\uCD95 \uACFC\uC815 \uC804\uBC18\uC5D0 \uB300\uD574 \uC804\uBB38 \uBA58\uD1A0\uB9C1\uACFC \uAE30\uC220 \uC790\uBB38\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4.","image":"unison.png","objectPosition":"left","deliverables":null,"form":"https://forms.gle/L4KMVFpAh8VMvT6ZA"},{"category":"ARCHIVED","name":"Project Re:vision","isApplicationOpen":false,"duration":"2025 Winter - 2026 Spring","client"